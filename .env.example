# Copy to .env and fill in. Both values are PUBLIC and safe to ship in the
# browser bundle: the anon key only grants what Row Level Security allows.
#
# Never put SUPABASE_SERVICE_ROLE_KEY (or any other secret) in a VITE_* variable.
# Vite inlines every VITE_* value into the client bundle at build time.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Production origin for auth email redirects (prevents localhost links in emails).
VITE_SITE_URL=https://hmgslab.com
